{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["**/*.js", "**/*.cjs", "**/*.mjs"],
	"exclude": ["node_modules", "dist"]
}
